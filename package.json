{
	"$schema": "https://json.schemastore.org/package",
	"name": "directus-extension-access-inspector",
	"version": "0.1.0",
	"description": "A Directus module that shows what a user, role or the public can do in each collection, field by field, and which policy granted it",
	"keywords": [
		"access",
		"directus",
		"directus-extension",
		"directus-extension-module",
		"permissions",
		"policies"
	],
	"homepage": "https://github.com/ComfortablyCoding/directus-extension-access-inspector#readme",
	"bugs": {
		"url": "https://github.com/ComfortablyCoding/directus-extension-access-inspector/issues"
	},
	"license": "MIT",
	"author": {
		"name": "ComfortablyCoding",
		"url": "https://github.com/ComfortablyCoding"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ComfortablyCoding/directus-extension-access-inspector.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --deny-warnings",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.6",
		"@types/node": "22.20.5",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"typescript": "5.9.3",
		"vitest": "5.0.3",
		"vue": "3.5.43",
		"vue-i18n": "11.1.12",
		"vue-router": "4.6.3",
		"vue-tsc": "3.3.12"
	},
	"icon": "policy",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@12.3.4",
	"directus:extension": {
		"type": "module",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^11.0.0 || ^12.0.0"
	}
}
